<Window x:Class="Learn_German_Basics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Learn German Basics"
        Width="1200"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#F5EBDD">

    <Window.Resources>

        <SolidColorBrush x:Key="SidebarColor" Color="#17212D"/>
        <SolidColorBrush x:Key="GermanRed" Color="#C92727"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFF9F0"/>

        <!-- Sidebar buttons -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#25303C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#394653"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#202833"/>
                                <Setter Property="Foreground"
                                        Value="#68717C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Level selection cards -->
        <Style x:Key="LevelCard" TargetType="Button">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Height" Value="260"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="#FFF9F0"/>
            <Setter Property="Foreground" Value="#17212D"/>
            <Setter Property="BorderBrush" Value="#E8DDD0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#C92727"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="#A92323"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#A92323"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
                Background="{StaticResource SidebarColor}">

            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0"
                            Margin="0,18,0,25">

                    <Border Width="72"
                            Height="72"
                            CornerRadius="36"
                            Background="White"
                            Padding="10"
                            HorizontalAlignment="Center">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#171717"
                                    CornerRadius="20,20,0,0"/>
                            <Border Grid.Row="1"
                                    Background="#DD2028"/>
                            <Border Grid.Row="2"
                                    Background="#F8C83E"
                                    CornerRadius="0,0,20,20"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Learn German"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,13,0,0"/>

                    <TextBlock Text="BASICS"
                               Foreground="#F34A42"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="A1  •  A2"
                               Foreground="#B8C2CF"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">

                    <Button Style="{StaticResource MenuButton}"
                            Content="⌂     Continue"
                            IsEnabled="False"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="＋     New"
                            Background="#A92323"
                            Click="New_Click"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="▤     Test"
                            Click="Test_Click"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="▥     Progress"
                            Click="Progress_Click"/>

                    <Button Style="{StaticResource MenuButton}"
                            Content="⇥     Exit"
                            Click="Exit_Click"/>
                </StackPanel>

                <!-- Footer has its own row -->
                <TextBlock Grid.Row="2"
                           Text="LERNEN • ENTDECKEN • WACHSEN"
                           Foreground="#8794A4"
                           FontSize="9"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,12,0,5"/>
            </Grid>
        </Border>

        <!-- ================= MAIN CONTENT AREA ================= -->

        <Grid x:Name="MainContent" Grid.Column="1"
              ClipToBounds="True">

            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="0,1">
                    <GradientStop Color="#A9CDE8" Offset="0"/>
                    <GradientStop Color="#FFF0D9" Offset="0.58"/>
                    <GradientStop Color="#E8A45B" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- German flag decoration -->
            <Viewbox Width="390"
                     Height="165"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Stretch="Fill"
                     IsHitTestVisible="False">

                <Canvas Width="390" Height="165">
                    <Path Fill="#242424"
                          Data="M 0,0 L 390,0 L 280,48 L 0,92 Z"/>
                    <Path Fill="#D62B2B"
                          Data="M 0,42 L 280,48 L 220,95 L 0,125 Z"/>
                    <Path Fill="#F5C34C"
                          Data="M 0,85 L 220,95 L 160,140 L 0,165 Z"/>
                </Canvas>
            </Viewbox>

            <!-- Decorative skyline -->
            <Canvas VerticalAlignment="Bottom"
                    Height="170"
                    IsHitTestVisible="False"
                    Opacity="0.35">

                <Rectangle Canvas.Left="0" Canvas.Bottom="0"
                           Width="1000" Height="55"
                           Fill="#9B795D"/>

                <Rectangle Canvas.Left="60" Canvas.Bottom="55"
                           Width="75" Height="95"
                           Fill="#7E7065"/>

                <Rectangle Canvas.Left="190" Canvas.Bottom="55"
                           Width="100" Height="120"
                           Fill="#9A7B64"/>

                <Rectangle Canvas.Left="340" Canvas.Bottom="55"
                           Width="70" Height="85"
                           Fill="#8C725C"/>

                <Rectangle Canvas.Left="490" Canvas.Bottom="55"
                           Width="115" Height="110"
                           Fill="#96775F"/>

                <Rectangle Canvas.Left="690" Canvas.Bottom="55"
                           Width="90" Height="135"
                           Fill="#9A7B64"/>

                <Rectangle Canvas.Left="850" Canvas.Bottom="55"
                           Width="75" Height="100"
                           Fill="#806A59"/>
            </Canvas>

            <!-- Welcome content -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="25"
                        MaxWidth="720">

                <Border Width="100"
                        Height="100"
                        CornerRadius="50"
                        Background="#FFFCF4"
                        Padding="13"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#171717"
                                CornerRadius="30,30,0,0"/>
                        <Border Grid.Row="1"
                                Background="#DD2028"/>
                        <Border Grid.Row="2"
                                Background="#F8C83E"
                                CornerRadius="0,0,30,30"/>
                    </Grid>
                </Border>

                <TextBlock Text="Learn German"
                           FontSize="43"
                           FontWeight="Bold"
                           Foreground="#17212D"
                           TextAlignment="Center"/>

                <TextBlock Text="BASICS"
                           FontSize="45"
                           FontWeight="Bold"
                           Foreground="#C92727"
                           TextAlignment="Center"/>

                <TextBlock Text="Your journey from A1 to A2 starts here."
                           FontSize="18"
                           Foreground="#46515B"
                           TextAlignment="Center"
                           Margin="0,15,0,8"/>

                <TextBlock Text="Learn the language. Discover Germany."
                           FontSize="15"
                           Foreground="#5B6269"
                           TextAlignment="Center"
                           Margin="0,0,0,25"/>

                <Border Background="#F4D7B9"
                        CornerRadius="16"
                        Padding="15,9"
                        HorizontalAlignment="Center">

                    <TextBlock Text="WILLKOMMEN IN DEUTSCHLAND"
                               Foreground="#8E2924"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                </Border>
            </StackPanel>

            <!-- ================= LEVEL POPUP ================= -->

            <Grid x:Name="LevelOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="10">

                <!-- Dark transparent backdrop -->
                <Border Background="#990E1722"/>

                <!-- Centered popup -->
                <Border Width="580"
                        Height="410"
                        MaxWidth="680"
                        MaxHeight="520"
                        Background="#F7F1E9"
                        BorderBrush="#FFFFFF"
                        BorderThickness="2"
                        CornerRadius="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="20">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Popup heading -->
                        <Grid Grid.Row="0"
                              Margin="0,0,0,12">

                            <StackPanel Margin="0,8,35,0">
                                <TextBlock Text="Choose Your Level"
                                           FontSize="27"
                                           FontWeight="Bold"
                                           Foreground="#17212D"
                                           HorizontalAlignment="Center"/>

                                <TextBlock Text="Start your German learning journey"
                                           FontSize="14"
                                           Foreground="#59616B"
                                           TextAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Content="✕"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="18"
                                    Cursor="Hand"
                                    Click="CloseLevelOverlay_Click"/>
                        </Grid>

                        <!-- Both cards fit within the remaining row -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- A1 -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource LevelCard}"
                                    Click="A1_Click"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="A1"
                                               FontSize="54"
                                               FontWeight="Bold"
                                               Foreground="#C92727"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="BEGINNER"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>

                                    <TextBlock Text="Start with the basics"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,15,0,0"/>

                                    <Border Background="#DDF2E2"
                                            CornerRadius="10"
                                            Padding="12,6"
                                            Margin="0,18,0,0">

                                        <TextBlock Text="UNLOCKED"
                                                   Foreground="#287747"
                                                   FontWeight="Bold"
                                                   FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- A2 -->
                            <Button x:Name="A2Button"
                                    Grid.Column="1"
                                    Style="{StaticResource LevelCard}"
                                    Background="#E0DDD7"
                                    Click="A2_Click"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="A2"
                                               FontSize="54"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>

                                    <TextBlock Text="ELEMENTARY"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>

                                    <TextBlock x:Name="A2Message"
                                               Text="🔒 LOCKED"
                                               FontSize="14"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,15,0,0"/>

                                    <TextBlock Text="Take test to enter"
                                               FontSize="12"
                                               Foreground="#A52B2B"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,12,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

            <!-- ================= TEST SECTION ================= -->
            <Grid x:Name="TestSection"
                  Visibility="Collapsed"
                  Background="#F5EBDD"
                  Panel.ZIndex="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#FFF9F0"
                        Padding="28,22"
                        BorderBrush="#E8DDD0"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Test Centre"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#17212D"/>
                        <TextBlock Text="Prepare for your A2 entry assessment."
                                   FontSize="15"
                                   Foreground="#59616B"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="30">
                    <TextBlock Text="A2 Entry Assessment"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#17212D"
                               TextAlignment="Center"/>
                    <TextBlock Text="Your assessment preparation will begin here."
                               FontSize="16"
                               Foreground="#59616B"
                               TextAlignment="Center"
                               Margin="0,12,0,22"/>
                    <Button Content="Start assessment"
                            Style="{StaticResource DialogActionButton}"
                            HorizontalAlignment="Center"
                            Click="OpenAssessmentStart_Click"/>
                    <Button Content="Back to welcome screen"
                            Background="Transparent"
                            Foreground="#A92323"
                            BorderThickness="0"
                            Padding="12,10"
                            Margin="0,8,0,0"
                            Cursor="Hand"
                            Click="BackToWelcome_Click"/>
                </StackPanel>
            </Grid>

            <!-- ================= A2 ASSESSMENT CONFIRMATION ================= -->
            <Grid x:Name="A2ConfirmOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="20">
                <Border Background="#990E1722"/>
                <Border Width="430"
                        MaxWidth="400"
                        Background="#FFF9F0"
                        BorderBrush="#FFFFFF"
                        BorderThickness="2"
                        CornerRadius="20"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="A2 Assessment"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#17212D"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Take an A2 entry assessment now?"
                                   FontSize="16"
                                   Foreground="#46515B"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,16,0,24"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Content="No"
                                    Style="{StaticResource DialogActionButton}"
                                    Background="#68717C"
                                    Margin="0,0,10,0"
                                    Click="A2ConfirmNo_Click"/>
                            <Button Content="Yes"
                                    Style="{StaticResource DialogActionButton}"
                                    Click="A2ConfirmYes_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= ASSESSMENT START CONFIRMATION ================= -->
            <Grid x:Name="AssessmentStartOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="21">
                <Border Background="#990E1722"/>
                <Border Width="440"
                        MaxWidth="400"
                        Background="#FFF9F0"
                        BorderBrush="#FFFFFF"
                        BorderThickness="2"
                        CornerRadius="20"
                        Padding="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Assessment Start?"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#17212D"
                                   TextAlignment="Center"/>
                        <TextBlock Text="The A2 assessment will begin after a 30-second preparation countdown."
                                   FontSize="15"
                                   Foreground="#46515B"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,16,0,24"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Content="No"
                                    Style="{StaticResource DialogActionButton}"
                                    Background="#68717C"
                                    Margin="0,0,10,0"
                                    Click="AssessmentStartNo_Click"/>
                            <Button Content="Yes, start"
                                    Style="{StaticResource DialogActionButton}"
                                    Click="AssessmentStartYes_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= 30-SECOND PREPARATION WINDOW ================= -->
            <Grid x:Name="AssessmentPrepOverlay"
                  Visibility="Collapsed"
                  Panel.ZIndex="22">
                <Border Background="#D9081728"/>
                <Border Width="520"
                        MaxWidth="480"
                        Background="#07162E"
                        BorderBrush="#315783"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="A2 ASSESSMENT"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#8DBFFF"
                                   TextAlignment="Center"
                                   Margin="0,0,0,12"/>
                        <TextBlock Text="The test will start in 30 seconds."
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="CountdownText"
                                   Text="00:30"
                                   FontSize="54"
                                   FontWeight="Bold"
                                   Foreground="#65B7FF"
                                   TextAlignment="Center"
                                   Margin="0,18,0,18"/>
                        <ProgressBar x:Name="CountdownProgress"
                                     Minimum="0"
                                     Maximum="30"
                                     Value="30"
                                     Height="6"
                                     Foreground="#168BFF"
                                     Background="#263A57"
                                     BorderThickness="0"/>
                        <TextBlock Text="Please get ready before the assessment begins."
                                   FontSize="14"
                                   Foreground="#D5E3F8"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,18,0,24"/>
                        <Button Content="Leave assessment"
                                Style="{StaticResource DialogActionButton}"
                                Background="#263A57"
                                BorderBrush="#7691B5"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch"
                                Click="LeaveAssessment_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
